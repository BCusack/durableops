{
  "name": "durableops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "node ./scripts/local-db.mjs up",
    "db:bootstrap": "node ./scripts/local-db.mjs bootstrap",
    "db:migrate": "node ./scripts/local-db.mjs migrate",
    "db:seed": "node ./scripts/local-db.mjs seed",
    "db:clean": "node ./scripts/clean-demo.mjs",
    "db:reset": "node ./scripts/local-db.mjs up-and-bootstrap && node ./scripts/local-db.mjs seed",
    "demo:seed": "node ./scripts/local-db.mjs seed",
    "demo:clean": "node ./scripts/clean-demo.mjs",
    "start:demo": "node ./scripts/local-db.mjs up-and-bootstrap && node ./scripts/local-db.mjs seed && next dev",
    "start:demo:offline": "next dev",
    "workflow:web": "npx workflow web"
  },
  "dependencies": {
    "@workflow/world-postgres": "5.0.0-beta.38",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "pg": "^8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "workflow": "5.0.0-beta.46",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^5.1.16"
  }
}
