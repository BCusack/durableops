WORKFLOW_TARGET_WORLD="@workflow/world-postgres"
WORKFLOW_POSTGRES_URL="postgresql://durableops:durableops@localhost:15432/durableops"
POSTGRES_DB="durableops"
POSTGRES_USER="durableops"
POSTGRES_PASSWORD="durableops"
NEXT_PUBLIC_APP_NAME="DurableOps"
# Set a long random value outside local demos. Used to sign session cookies.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Local demo tech-team account.
TECH_USERNAME="tech"
TECH_PASSWORD="replace-with-a-long-random-password"

# Optional ticket advisor. Set to "openai" or "anthropic" after setting its matching API key.
# Advice is generated server-side at ticket submission and visible only to tech users.
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
TICKET_ADVISOR_COMPANY_CONTEXT="DurableOps supports the Australian Government's new initiative to help triage and solve citizens' everyday problems. Provide practical, safe operational guidance for government tech support."
